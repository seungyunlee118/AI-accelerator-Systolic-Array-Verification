// Block-level environment for the CSR block: AXI4-Lite agent + RAL model.
//
// The register model is updated by an explicit predictor that watches the AXI4-Lite monitor
// (auto-predict is off). So the mirror follows what really happened on the bus, including
// accesses that did not come from RAL sequences.
class sa_csr_env extends uvm_env;
  `uvm_component_utils(sa_csr_env)

  axil_agent                   axil;
  sa_gemm_csr                  regmodel;    // generated by PeakRDL from ral/sa_gemm_csr.rdl
  axil_reg_adapter             adapter;
  uvm_reg_predictor #(axil_item) predictor;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    axil = axil_agent::type_id::create("axil", this);

    regmodel = new("regmodel");             // generated class has no factory registration
    regmodel.build();
    regmodel.lock_model();
    regmodel.reset();

    adapter   = axil_reg_adapter::type_id::create("adapter");
    predictor = uvm_reg_predictor#(axil_item)::type_id::create("predictor", this);
  endfunction

  virtual function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    regmodel.default_map.set_sequencer(axil.sqr, adapter);
    regmodel.default_map.set_auto_predict(0);
    predictor.map     = regmodel.default_map;
    predictor.adapter = adapter;
    axil.mon.ap.connect(predictor.bus_in);
  endfunction
endclass
